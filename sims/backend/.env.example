# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Default = the zero-install dev database (`npm run dev:db`).
# Using your own Postgres? Change this and run `npm run db:init`.
DATABASE_URL=postgresql://postgres:postgres@localhost:54330/sims

# >= 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (so req.ip is the real client IP). 0 = none.
TRUST_PROXY=0

# Public URL of the front-end (used in password-reset links)
APP_URL=http://localhost:5173

# Failed key guesses (per IP or account) allowed in 15 minutes before a lockout
KEY_MAX_FAILED_ATTEMPTS=10

# --- production only (see docs/DEPLOYMENT.md) ---
# Secure flag on the refresh cookie (+ CSP upgrade-insecure-requests, HSTS). Defaults to true when NODE_ENV=production;
# set false ONLY to try a production build over plain http.
# COOKIE_SECURE=true
# Folder with the built web app (frontend/dist) to serve from this process. Default: ../frontend/dist in production,
# nothing in development. "off" = serve the API only.
# FRONTEND_DIST=../frontend/dist
