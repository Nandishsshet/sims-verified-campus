{
  "name": "sims-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Student Information Management System — API server",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db-init.js",
    "db:catalog": "node scripts/db-init.js catalog",
    "dev:db": "node scripts/dev-db.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/test-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
