# Settings for `docker compose` (this file is for the repo root; backend/.env.example is for running without Docker).
# Copy to .env and fill in. NEVER commit .env.

# Database password. Use letters and digits only (it is placed inside a connection URL). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DB_PASSWORD=

# Signs access tokens; at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# The address users open. For a real deployment use your https URL.
APP_URL=http://localhost:8080
APP_PORT=8080

# true when a TLS-terminating proxy sits in front of the app (nginx, Caddy, a cloud load balancer)
TRUST_PROXY=0

# Cookies are only sent over https when true (the default and the right setting for production).
# For a plain-http trial on localhost, set false.
COOKIE_SECURE=true
